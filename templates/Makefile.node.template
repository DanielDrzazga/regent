# Makefile — Node.js / TypeScript
# Generated by /regent:init. Adjust PKG_MANAGER and the Database section to your project.
#
# Usage: make help

# npm | pnpm | yarn
PKG_MANAGER ?= npm

# === Tests ===
# The test-unit / test-integration targets require the "test:unit" / "test:integration" scripts
# in package.json — define them for your runner, e.g.:
#   Jest:   "test:unit": "jest tests/unit"
#   Vitest: "test:unit": "vitest run tests/unit"
# PATTERN narrows the run to a module/file: make test-unit PATTERN=user
.PHONY: test test-unit test-integration test-e2e test-coverage

test:              ## Run all tests
	$(PKG_MANAGER) test

test-unit:         ## Run unit tests (make test-unit PATTERN=user)
	$(PKG_MANAGER) run test:unit -- $(PATTERN)

test-integration:  ## Run integration tests
	$(PKG_MANAGER) run test:integration -- $(PATTERN)

test-e2e:          ## Run E2E tests — API or browser, per the project
	$(PKG_MANAGER) exec playwright test

test-coverage:     ## Run tests with a coverage report
	$(PKG_MANAGER) test -- --coverage

# === Frontend (uncomment together with .PHONY when the project has a frontend) ===
# Requires the "test:component" script in package.json, e.g. "vitest run tests/component"
# .PHONY: test-component
# test-component:  ## UI component tests (make test-component PATTERN=LoginForm)
# 	$(PKG_MANAGER) run test:component -- $(PATTERN)

# === Code quality ===
.PHONY: lint lint-fix format type-check

lint:              ## Run the linter
	$(PKG_MANAGER) run lint

lint-fix:          ## Run the linter with auto-fixes
	$(PKG_MANAGER) run lint -- --fix

format:            ## Format the code
	$(PKG_MANAGER) run format

type-check:        ## Check TypeScript types
	$(PKG_MANAGER) run type-check

# === Checks ===
# check — framework gates (/regent:apply Step 2, /regent:verify Stage 1, /regent:bugfix, /regent:dependency-update)
# check-quick — fast local loop (optional, not used by commands)
.PHONY: check check-quick

check:             ## Full check (lint + types + tests)
	$(MAKE) lint
	$(MAKE) type-check
	$(MAKE) test

check-quick:       ## Quick check (lint + types)
	$(MAKE) lint
	$(MAKE) type-check

# === Build ===
.PHONY: build dev

build:             ## Production build
	$(PKG_MANAGER) run build

dev:               ## Run the development server
	$(PKG_MANAGER) run dev

# === Docker ===
.PHONY: docker-up docker-down docker-restart docker-logs docker-ps docker-shell

docker-up:         ## Start all containers in the background
	docker compose up -d

docker-down:       ## Stop and remove containers
	docker compose down

docker-restart:    ## Restart containers
	docker compose restart

docker-logs:       ## Follow logs of all containers
	docker compose logs -f

docker-ps:         ## Show container status
	docker compose ps

docker-shell:      ## Open a shell in the app container (make docker-shell SVC=app)
	docker compose exec $(SVC) sh

# === Database (through Docker) ===
# Uncomment (together with .PHONY) and adjust to your ORM (Prisma / TypeORM / Knex / MikroORM)
# .PHONY: db-migrate db-seed db-reset

# --- Prisma ---
# db-migrate:      ## Run migrations
# 	docker compose exec app $(PKG_MANAGER) exec prisma migrate dev
# db-seed:         ## Seed the database with test data
# 	docker compose exec app $(PKG_MANAGER) exec prisma db seed
# db-reset:        ## Reset the database (DESTRUCTIVE)
# 	docker compose exec app $(PKG_MANAGER) exec prisma migrate reset

# --- TypeORM ---
# db-migrate:      ## Run migrations
# 	docker compose exec app $(PKG_MANAGER) run typeorm migration:run
# db-seed:         ## Seed the database with test data
# 	docker compose exec app $(PKG_MANAGER) run seed
# db-reset:        ## Reset the database (DESTRUCTIVE)
# 	docker compose exec app $(PKG_MANAGER) run typeorm schema:drop && $(MAKE) db-migrate

# === Dependencies ===
.PHONY: install deps-outdated deps-audit deps-audit-fix deps-update deps-upgrade

install:           ## Install dependencies
	$(PKG_MANAGER) install

deps-outdated:     ## Show outdated packages
	$(PKG_MANAGER) outdated

deps-audit:        ## Scan for security vulnerabilities
	$(PKG_MANAGER) audit

# NOTE: "audit fix" works for npm; pnpm: "pnpm audit --fix"; yarn classic has no
# equivalent (use "yarn upgrade" per package) — adjust to PKG_MANAGER.
deps-audit-fix:    ## Auto-fix security vulnerabilities
	$(PKG_MANAGER) audit fix

deps-update:       ## Update a package (make deps-update PKG=express)
	$(PKG_MANAGER) update $(PKG)

deps-upgrade:      ## Upgrade to the latest version (make deps-upgrade PKG=express)
	$(PKG_MANAGER) install $(PKG)@latest

# === Help ===
.PHONY: help

help:              ## Show available commands
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | \
		awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-20s\033[0m %s\n", $$1, $$2}'

.DEFAULT_GOAL := help
